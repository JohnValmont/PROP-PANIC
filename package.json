{
  "name": "prop-panic",
  "version": "2.10.0",
  "private": true,
  "type": "module",
  "description": "PROP PANIC — Blend in. Don't get caught. A browser multiplayer prop-hunt party game.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts",
    "test:e2e": "node test/e2e.cjs",
    "test:ghost": "node test/ghost.cjs",
    "test:match": "node test/match.cjs",
    "test:soak": "tsx test/soak.ts",
    "test:mechanics": "tsx test/mechanics.ts",
    "test:maps": "tsx test/maps.ts",
    "test:security": "tsx test/security.ts",
    "test:audio": "tsx test/audio.ts",
    "test:progress": "tsx test/progress.ts",
    "test:stats": "tsx test/stats.ts",
    "audio:render": "node tools/render-audio.cjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
